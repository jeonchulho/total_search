# Shared
API_KEY=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false

# MinIO buckets
MINIO_WEBHARD_BUCKET=webhard
MINIO_MILVUS_BUCKET=milvus-data

# Webhard
WEBHARD_DB_PATH=/data/webhard.db
# Optional: override DB engine/url (sqlite/mysql/postgresql/oracle)
# Examples:
# DATABASE_URL=sqlite:////data/webhard.db
# DATABASE_URL=mysql+pymysql://user:pass@mysql:3306/webhard
# DATABASE_URL=postgresql+psycopg://user:pass@postgres:5432/webhard
# DATABASE_URL=oracle+oracledb://user:pass@oracle:1521/?service_name=FREEPDB1
DATABASE_URL=
AUTH_TOKEN_TTL_HOURS=24

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=documents
MILVUS_AUTO_MIGRATE_DIM=false
MILVUS_BACKUP_PREFIX=backup
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BGE_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_AUTO_BATCH=true
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_DEVICE=cpu
VECTOR_DIM=384

# Service ports
SEARCH_API_PORT=8000
WEBHARD_API_PORT=8001
